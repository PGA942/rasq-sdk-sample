{
  "schema": "rasq.slots/1",
  "$comment": "スロット登録簿 (D-005)。プラグインが差し込める面を 1 か所で定義する。マニフェストの `slots` はここにある id だけを指せる(schema/validate.py が照合)。`status: planned` は仮案(RRL&プラグイン周り §17)から採った未実装の面で、id だけ先に予約する。 tiers: 権限ティア(PROTOCOL §6 V1)。サイドロード(未審査)は content だけ、media は tag だけ、action / avatar / full / page は審査済みのみ。 permissions.required はホスト(rasq-client slot_plugins.dart)が v1 で実際に見る権限(fow.* / storage.* / mute.words)だけ。操作語彙(replace_media / register_action など、CONTRACT §8)は審査で付くので optional。",
  "tiers": {
    "content": {
      "sideload": true,
      "description": "投稿内容の加工・並べ替え・サジェスト。画面を持たず、GPU / ネットワークも使えない(V2)"
    },
    "media": {
      "sideload": "tagOnly",
      "description": "メディアの tag 付けはサイドロード可。差し替え(replace_media)は審査済み"
    },
    "action": {
      "sideload": false,
      "description": "ボタン・FOW・オーバーレイなど、ユーザーが押して動く面"
    },
    "avatar": {
      "sideload": false,
      "description": "アバター装飾(decorate_avatar)"
    },
    "full": {
      "sideload": false,
      "description": "タイル / 画面の完全置き換え(replace_tile)。必須ロールの保証が要る(V5)"
    },
    "page": {
      "sideload": false,
      "description": "ページ型(custom:<pluginId>)。ホストのルーティングと一緒に決める"
    }
  },
  "lifecycle": {
    "$comment": "FOW / 拡張面に共通のライフサイクル(仮案 §17)。v1 wasm ABI では call(\"lifecycle\", {kind, surface?}) として届く。",
    "kinds": [
      "mount",
      "unmount",
      "visible",
      "hidden",
      "cancel"
    ],
    "stateScope": [
      "ephemeral",
      "component",
      "screen",
      "account",
      "plugin"
    ],
    "offscreenPolicy": [
      "keepAlive",
      "suspend",
      "dispose"
    ],
    "fallback": [
      "loading",
      "timeout",
      "crashed",
      "permissionDenied",
      "unsupported",
      "offline"
    ],
    "hostOwned": "最終 fallback と 閉じる / 無効化 の操作はホストが持つ(仮案 §18)"
  },
  "slots": [
