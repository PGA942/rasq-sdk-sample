{
  "schema": "rasq.plugin-manifest/1",
  "id": "{{id}}",
  "name": "{{display}}",
  "version": "0.1.0",
  "kind": "mediaViewer",
  "description": "{{display}}(rasq new viewer.overlay の雛形)",
  "slots": [
    "viewer.overlay"
  ],
  "permissions": [
    "fow.widget"
  ],
  "actions": [
    {
      "id": "toggle",
      "slot": "viewer.overlay",
      "label": "{{display}}",
      "icon": "center_focus_weak",
      "tags": [
        "全画面表示"
      ],
      "auto": true
    }
  ]
}
